# MongoDB (giống MONGO_URI của backend)
MONGO_URI=mongodb://127.0.0.1:27017/wedding_db

# AWS S3
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=wedding-an-thuy-photos
S3_PREFIX=photos/
# Để trống nếu dùng URL mặc định https://<bucket>.s3.<region>.amazonaws.com/<key>
# Điền vào nếu dùng CloudFront/custom domain, ví dụ: https://cdn.example.com
S3_PUBLIC_BASE_URL=
# true nếu bucket cho phép set ACL object (Object Ownership != "Bucket owner enforced").
# Mặc định để false và dùng Bucket Policy để public-read.
S3_USE_ACL=false

# Thư mục chứa ảnh gốc (RAW export), mặc định là "../19 chụp thuy -an"
SOURCE_DIR=

# Giới hạn kích thước sau resize (FullHD)
MAX_WIDTH=1920
MAX_HEIGHT=1080
JPEG_QUALITY=82
